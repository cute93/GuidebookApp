<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F5F5F5">

    <!-- Title + Nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvProblemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="문제 제목" />

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이전 문제"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="다음 문제"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그아웃"
            android:layout_marginStart="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="#F44336"
            app:strokeColor="#F44336"/>
    </LinearLayout>

    <!-- Problem Image -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/ivProblem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:background="#D9D9D9" />
    </androidx.cardview.widget.CardView>

    <!-- Teacher Panel -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvTeacherName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="교사"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <ImageView
                android:id="@+id/ivTeacherNote"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:background="#EEEEEE"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btnTeacherWrite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="해결포인트 작성"
                android:backgroundTint="@color/green_accent"
                android:textColor="#000000"
                android:textSize="12sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Student Panels Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <!-- Student 1 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginEnd="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/tvStudent1Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="학생1"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>
                <ImageView
                    android:id="@+id/ivStudent1Note"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="4dp"/>
                <Button
                    android:id="@+id/btnStudent1Write"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="작성"
                    android:backgroundTint="@color/green_accent"
                    android:textColor="#000000"
                    android:textSize="11sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Student 2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/tvStudent2Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="학생2"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>
                <ImageView
                    android:id="@+id/ivStudent2Note"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="4dp"/>
                <Button
                    android:id="@+id/btnStudent2Write"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="작성"
                    android:backgroundTint="@color/green_accent"
                    android:textColor="#000000"
                    android:textSize="11sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Student 3 -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginStart="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/tvStudent3Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="학생3"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>
                <ImageView
                    android:id="@+id/ivStudent3Note"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="4dp"/>
                <Button
                    android:id="@+id/btnStudent3Write"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="작성"
                    android:backgroundTint="@color/green_accent"
                    android:textColor="#000000"
                    android:textSize="11sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Teacher-only upload button -->
    <Button
        android:id="@+id/btnUploadProblem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="문제 업로드 (교사)"
        android:backgroundTint="@color/green_accent"
        android:textColor="#000000"
        android:layout_marginTop="4dp"
        android:visibility="gone"/>

</LinearLayout>
